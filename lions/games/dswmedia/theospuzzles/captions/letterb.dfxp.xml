		<p begin="00:00:04.267" end="00:00:05.933">Basketball.</p>
		<p begin="00:00:05.933" end="00:00:07.400">Baseball.</p>
		<p begin="00:00:07.400" end="00:00:09.133">Beachball.</p>
		<p begin="00:00:09.133" end="00:00:10.133">Boy.</p>
		<p begin="00:00:10.133" end="00:00:11.333">Boat.</p>
		<p begin="00:00:11.333" end="00:00:12.733">Banana.</p>
		<p begin="00:00:12.733" end="00:00:13.933">&quot;B.&quot;</p>
